diff --git a/sql/13_notificaciones_comprobantes.sql b/sql/13_notificaciones_comprobantes.sql
new file mode 100644
index 0000000..d33370f
--- /dev/null
+++ b/sql/13_notificaciones_comprobantes.sql
@@ -0,0 +1,16 @@
+CREATE TABLE IF NOT EXISTS public.notificaciones (
+    id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    fecha_creacion timestamptz NOT NULL DEFAULT now()
+);
+
+ALTER TABLE public.notificaciones
+    ADD COLUMN IF NOT EXISTS venta_id bigint REFERENCES public.ventas(id) ON DELETE SET NULL,
+    ADD COLUMN IF NOT EXISTS canal text,
+    ADD COLUMN IF NOT EXISTS destinatario text,
+    ADD COLUMN IF NOT EXISTS tipo text,
+    ADD COLUMN IF NOT EXISTS estado_envio text,
+    ADD COLUMN IF NOT EXISTS codigo_error text;
+
+CREATE INDEX IF NOT EXISTS idx_notificaciones_venta ON public.notificaciones (venta_id);
+
+ALTER TABLE public.notificaciones ENABLE ROW LEVEL SECURITY;
