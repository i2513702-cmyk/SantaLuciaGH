diff --git a/app/templates/partials/estado_badge.html b/app/templates/partials/estado_badge.html
new file mode 100644
index 0000000..0ce59b6
--- /dev/null
+++ b/app/templates/partials/estado_badge.html
@@ -0,0 +1,6 @@
+{% macro estado_badge(estado) %}
+{% set e = (estado or '')|upper %}
+{% set c = 'success' if ('PAGAD' in e or 'ENTREGAD' in e or 'CONFIRM' in e or 'COMPLET' in e) else ('danger' if ('CANCEL' in e or 'ANUL' in e or 'FALL' in e) else ('warning' if 'PEND' in e else 'secondary')) %}
+{% set i = {'success': 'check-circle', 'danger': 'x-circle', 'warning': 'hourglass-split', 'secondary': 'dot'}[c] %}
+<span class="badge rounded-pill text-bg-{{ c }}"><i class="bi bi-{{ i }}"></i> {{ (estado or '—')|replace('_', ' ')|capitalize }}</span>
+{% endmacro %}
diff --git a/app/templates/ventas/detalle.html b/app/templates/ventas/detalle.html
new file mode 100644
index 0000000..150e1f6
--- /dev/null
+++ b/app/templates/ventas/detalle.html
@@ -0,0 +1,55 @@
+{% extends "base.html" %}
+{% from "partials/estado_badge.html" import estado_badge %}
+{% block title %}Pedido {{ venta.codigo_pedido or venta.id }} — {{ app_name }}{% endblock %}
+
+{% block content %}
+<a class="small text-decoration-none" href="{{ url_for('ventas.listado') }}"><i class="bi bi-arrow-left"></i> Volver a ventas</a>
+<div class="d-flex flex-wrap align-items-center gap-3 my-3">
+    <h1 class="h3 fw-bold mb-0">Pedido {{ venta.codigo_pedido or ('#' ~ venta.id) }}</h1>
+    {{ estado_badge(venta.estado) }}
+    <span class="text-secondary small ms-auto">{{ (venta.fecha_venta or '')[:16].replace('T', ' ') }}</span>
+</div>
+
+<div class="row g-4">
+    <div class="col-lg-8">
+        <div class="card no-hover mb-4"><div class="card-body p-0">
+            <div class="table-responsive"><table class="table align-middle mb-0">
+                <thead><tr><th>Producto</th><th class="text-end">Cant.</th><th class="text-end">Precio</th><th class="text-end">Subtotal</th></tr></thead>
+                <tbody>{% for i in items %}
+                    <tr><td class="fw-semibold">{{ i.nombre }}</td><td class="text-end">{{ i.cantidad }}</td>
+                        <td class="text-end">S/ {{ "%.2f"|format(i.precio_unitario or 0) }}</td>
+                        <td class="text-end fw-bold">S/ {{ "%.2f"|format(i.subtotal or 0) }}</td></tr>
+                {% else %}<tr><td colspan="4" class="text-center text-secondary py-4">Sin líneas de detalle.</td></tr>{% endfor %}</tbody>
+            </table></div>
+        </div></div>
+        {% if pagos %}
+        <div class="card no-hover"><div class="card-body">
+            <h2 class="h6 fw-bold mb-3"><i class="bi bi-credit-card"></i> Pagos</h2>
+            {% for p in pagos %}
+                <div class="d-flex justify-content-between align-items-center border-bottom py-2">
+                    <span>{{ (p.pasarela or 'Pago')|capitalize }} · <small class="text-secondary">{{ (p.fecha_pago or p.fecha_creacion or '')[:16].replace('T',' ') }}</small></span>
+                    <span>{{ estado_badge(p.estado) }} <strong class="ms-2">S/ {{ "%.2f"|format(p.monto or 0) }}</strong></span>
+                </div>
+            {% endfor %}
+        </div></div>
+        {% endif %}
+    </div>
+    <div class="col-lg-4">
+        <div class="card no-hover mb-4"><div class="card-body">
+            <h2 class="h6 fw-bold mb-3">Resumen</h2>
+            <div class="d-flex justify-content-between"><span class="text-secondary">Subtotal</span><span>S/ {{ "%.2f"|format(venta.subtotal or 0) }}</span></div>
+            <div class="d-flex justify-content-between"><span class="text-secondary">Descuento</span><span>- S/ {{ "%.2f"|format(venta.descuento or 0) }}</span></div>
+            <div class="d-flex justify-content-between"><span class="text-secondary">Envío</span><span>S/ {{ "%.2f"|format(venta.costo_envio or 0) }}</span></div>
+            <hr><div class="d-flex justify-content-between h5 mb-0"><span>Total</span><span class="text-primary fw-bold">S/ {{ "%.2f"|format(venta.total or 0) }}</span></div>
+        </div></div>
+        <div class="card no-hover"><div class="card-body small">
+            <h2 class="h6 fw-bold mb-3">Cliente y entrega</h2>
+            <div class="mb-1"><i class="bi bi-person"></i> {{ nombre_cliente or (usuario.nombre_usuario if usuario) or 'Cliente web' }}</div>
+            {% if cliente and cliente.telefono %}<div class="mb-1"><i class="bi bi-telephone"></i> {{ cliente.telefono }}</div>{% endif %}
+            {% if (cliente and cliente.correo) or (usuario and usuario.correo) %}<div class="mb-1"><i class="bi bi-envelope"></i> {{ (cliente.correo if cliente and cliente.correo) or usuario.correo }}</div>{% endif %}
+            <div class="mb-1 text-capitalize"><i class="bi bi-shop"></i> {{ (venta.canal_venta or '—')|lower }} · {{ (venta.tipo_entrega or '—')|lower|replace('_',' ') }}</div>
+            {% if venta.observaciones %}<div class="mt-2 text-secondary"><i class="bi bi-chat-left-text"></i> {{ venta.observaciones }}</div>{% endif %}
+        </div></div>
+    </div>
+</div>
+{% endblock %}
diff --git a/app/templates/ventas/listado.html b/app/templates/ventas/listado.html
new file mode 100644
index 0000000..5a6ca5e
--- /dev/null
+++ b/app/templates/ventas/listado.html
@@ -0,0 +1,79 @@
+{% extends "base.html" %}
+{% from "partials/estado_badge.html" import estado_badge %}
+{% block title %}Ventas — {{ app_name }}{% endblock %}
+
+{% block content %}
+<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
+    <div>
+        <h1 class="h3 fw-bold mb-0">{{ icono('nav-ventas', 'receipt', 28) }} Ventas y pedidos</h1>
+        <small class="text-secondary">{{ resumen.pedidos }} pedido(s) con los filtros actuales</small>
+    </div>
+</div>
+
+{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
+
+<div class="row g-3 mb-4">
+    <div class="col-6 col-lg-4"><div class="card no-hover h-100"><div class="card-body">
+        <small class="text-secondary">Total vendido</small><div class="h3 fw-bold mb-0 text-primary">S/ {{ "%.2f"|format(resumen.monto) }}</div></div></div></div>
+    <div class="col-6 col-lg-4"><div class="card no-hover h-100"><div class="card-body">
+        <small class="text-secondary">Pedidos</small><div class="h3 fw-bold mb-0">{{ resumen.pedidos }}</div></div></div></div>
+    <div class="col-12 col-lg-4"><div class="card no-hover h-100"><div class="card-body">
+        <small class="text-secondary">Ticket promedio</small><div class="h3 fw-bold mb-0">S/ {{ "%.2f"|format(resumen.ticket) }}</div></div></div></div>
+</div>
+
+<form method="get" class="card no-hover mb-3"><div class="card-body">
+    <div class="row g-2 align-items-end">
+        <div class="col-12 col-md-4"><label class="form-label small mb-1">Buscar código</label>
+            <div class="input-group"><span class="input-group-text"><i class="bi bi-search"></i></span>
+            <input name="q" value="{{ f.q or '' }}" class="form-control" placeholder="Ej: PED-0012"></div></div>
+        <div class="col-6 col-md-2"><label class="form-label small mb-1">Estado</label>
+            <select name="estado" class="form-select"><option value="">Todos</option>
+            {% for e in estados %}<option value="{{ e }}" {{ 'selected' if f.estado == e }}>{{ e|replace('_',' ')|capitalize }}</option>{% endfor %}</select></div>
+        <div class="col-6 col-md-2"><label class="form-label small mb-1">Canal</label>
+            <select name="canal" class="form-select"><option value="">Todos</option>
+            {% for c in canales %}<option value="{{ c }}" {{ 'selected' if f.canal == c }}>{{ c|capitalize }}</option>{% endfor %}</select></div>
+        <div class="col-6 col-md-2"><label class="form-label small mb-1">Desde</label><input type="date" name="desde" value="{{ f.desde or '' }}" class="form-control"></div>
+        <div class="col-6 col-md-2"><label class="form-label small mb-1">Hasta</label><input type="date" name="hasta" value="{{ f.hasta or '' }}" class="form-control"></div>
+    </div>
+    <div class="d-flex flex-wrap gap-2 mt-3 align-items-center">
+        <button class="btn btn-primary btn-sm px-4"><i class="bi bi-funnel"></i> Filtrar</button>
+        {% if f %}<a class="btn btn-sm btn-outline-secondary" href="{{ url_for('ventas.listado') }}">Limpiar</a>{% endif %}
+        <span class="vr mx-1"></span>
+        {% for nombre, (d, h) in atajos.items() %}
+            <a class="btn btn-sm btn-light border" href="{{ url_for('ventas.listado', desde=d.isoformat(), hasta=h.isoformat()) }}">{{ nombre }}</a>
+        {% endfor %}
+    </div>
+</div></form>
+
+<div class="card no-hover">
+    <div class="table-responsive">
+        <table class="table table-hover align-middle mb-0">
+            <thead><tr><th>Pedido</th><th>Fecha</th><th>Cliente</th><th>Canal</th><th>Estado</th><th class="text-end">Total</th><th></th></tr></thead>
+            <tbody>
+            {% for v in ventas %}
+                <tr role="link" style="cursor:pointer" onclick="location.href='{{ url_for('ventas.detalle', venta_id=v.id) }}'">
+                    <td class="fw-semibold">{{ v.codigo_pedido or ('#' ~ v.id) }}</td>
+                    <td class="small text-secondary">{{ (v.fecha_venta or '')[:16].replace('T', ' ') }}</td>
+                    <td>{{ v.cliente }}</td>
+                    <td class="text-capitalize small">{{ (v.canal_venta or '—')|lower }}{% if v.tipo_entrega %} · {{ v.tipo_entrega|lower|replace('_',' ') }}{% endif %}</td>
+                    <td>{{ estado_badge(v.estado) }}</td>
+                    <td class="text-end fw-bold">S/ {{ "%.2f"|format(v.total or 0) }}</td>
+                    <td class="text-end"><i class="bi bi-chevron-right text-secondary"></i></td>
+                </tr>
+            {% else %}
+                <tr><td colspan="7" class="text-center py-5 text-secondary">
+                    <div class="fs-1"><i class="bi bi-inbox"></i></div>No hay ventas con estos filtros.</td></tr>
+            {% endfor %}
+            </tbody>
+        </table>
+    </div>
+</div>
+
+{% if paginas > 1 %}
+<nav class="d-flex justify-content-center align-items-center gap-3 mt-4">
+    <a class="btn btn-sm btn-outline-primary {{ 'disabled' if pagina <= 1 }}" href="{{ url_for('ventas.listado', p=pagina-1, **args) }}"><i class="bi bi-chevron-left"></i> Anterior</a>
+    <span class="small text-secondary">Página {{ pagina }} de {{ paginas }}</span>
+    <a class="btn btn-sm btn-outline-primary {{ 'disabled' if pagina >= paginas }}" href="{{ url_for('ventas.listado', p=pagina+1, **args) }}">Siguiente <i class="bi bi-chevron-right"></i></a>
+</nav>
+{% endif %}
+{% endblock %}
-- 
