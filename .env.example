# Copia este archivo a `.env` y completa los valores de TU proyecto Supabase.
# La clave publishable y la service_role se obtienen en:
#   Supabase Dashboard -> Settings -> API keys

# URL del proyecto Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# API key publishable (anon). Se puede exponer al frontend.
SUPABASE_KEY=sb_publishable_...

# service_role (SECRETO, solo servidor). Omite RLS: usada para leer todas
# las filas y para escrituras (insert/update/delete). NUNCA exponerla.
SUPABASE_SERVICE_KEY=eyJ...

# Secreto de webhooks (opcional)
SUPABASE_WEBHOOK_SECRET=

# Clave para firmar sesiones de Flask (usa un valor largo y aleatorio)
SECRET_KEY=cambia-esta-clave